# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL:
#   http://127.0.0.1:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: Fernet key for encrypting OAuth tokens at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
DEFAULT_MODEL=ministral-3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
HOST=127.0.0.1
PORT=8000
# Default: embedded SQLite (no PostgreSQL required). Override for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://YOUR_USER@127.0.0.1:5432/github_agent
