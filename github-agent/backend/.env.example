# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL:
#   http://127.0.0.1:47831/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: Fernet key for encrypting OAuth tokens at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
# Chats, settings and models are stored in ~/Library/Application Support/GitHub Agent/
# (override with GITHUB_AGENT_DATA_DIR).
