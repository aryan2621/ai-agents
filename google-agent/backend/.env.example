# Use a "Desktop app" OAuth client in Google Cloud Console (not Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: Fernet key for encrypting OAuth tokens at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
DEFAULT_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
HOST=127.0.0.1
PORT=8000
# Default: embedded SQLite (no PostgreSQL required). Override for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://YOUR_USER@127.0.0.1:5432/google_agent
