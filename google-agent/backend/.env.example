# Use a "Desktop app" OAuth client in Google Cloud Console (not Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: Fernet key for encrypting OAuth tokens at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
# Chats, settings and models are stored in ~/Library/Application Support/Google Agent/
# (override with GOOGLE_AGENT_DATA_DIR).
